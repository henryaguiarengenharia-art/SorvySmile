rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isHq() {
      return signedIn() && currentUser().data.role == 'hq';
    }

    function belongsTo(accountId) {
      return signedIn() && currentUser().data.accountId == accountId;
    }

    function accountAccessActive(accountId) {
      let account = get(/databases/$(database)/documents/accounts/$(accountId));
      return account.data.status == 'active'
        && (
          !('renewAtMs' in account.data)
          || account.data.renewAtMs == null
          || account.data.renewAtMs > request.time.toMillis()
          || (
            (!('subscriptionStatus' in account.data) || account.data.subscriptionStatus != 'active')
            && (!('paymentStatus' in account.data) || account.data.paymentStatus != 'confirmed')
          )
        )
        && (
          !('trialStatus' in account.data)
          || (
            account.data.trialStatus != 'expired'
            && (
              account.data.trialStatus != 'active'
              || account.data.trialEndsAtMs > request.time.toMillis()
            )
          )
        );
    }

    function isClinicManager() {
      return signedIn() && currentUser().data.role == 'clinic';
    }

    function isAssignedProfessional(professionalId) {
      return signedIn()
        && currentUser().data.role == 'professional'
        && currentUser().data.professionalId == professionalId;
    }

    match /publicProfiles/{slug} {
      allow get: if resource.data.active == true || isHq();
      allow list: if false;
      allow write: if false;
    }

    match /publicSlugAliases/{slug} {
      allow get: if true;
      allow list, write: if false;
    }

    match /dailyPosts/{postId} {
      allow read: if isHq() || (signedIn() && resource.data.status == 'published');
      allow write: if false;
    }

    match /dailyPostTemplates/{templateId} {
      allow read: if isHq() || (signedIn() && resource.data.status == 'published');
      allow write: if false;
    }

    match /professionalContentPreferences/{professionalId} {
      allow read: if isHq()
        || isAssignedProfessional(professionalId)
        || (isClinicManager() && belongsTo(resource.data.accountId));
      allow write: if false;
    }

    match /dailyPostAssignments/{assignmentId} {
      allow read: if isHq()
        || isAssignedProfessional(resource.data.professionalId)
        || (isClinicManager() && belongsTo(resource.data.accountId));
      allow write: if false;
    }

    match /dailyPostEvents/{eventId} {
      allow read: if isHq();
      allow write: if false;
    }

    match /funnelEvents/{eventId} {
      allow read: if isHq();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isHq());
      allow write: if false;
    }

    match /accounts/{accountId} {
      allow read: if isHq() || belongsTo(accountId);
      allow write: if false;
    }

    match /professionals/{professionalId} {
      allow read: if isHq()
        || (isClinicManager() && belongsTo(resource.data.accountId))
        || isAssignedProfessional(professionalId);
      allow create, delete: if false;
      allow update: if isAssignedProfessional(professionalId)
        && belongsTo(resource.data.accountId)
        && accountAccessActive(resource.data.accountId)
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'whatsapp',
          'city',
          'state',
          'bio',
          'bioLink',
          'standardMessage',
          'templates',
          'updatedAtMs'
        ]);
    }

    match /leads/{leadId} {
      allow read: if isHq()
        || (isClinicManager() && belongsTo(resource.data.accountId))
        || (
          belongsTo(resource.data.accountId)
          && isAssignedProfessional(resource.data.professionalId)
        );
      allow create, delete: if false;
      allow update: if (
          isHq()
          || (isClinicManager() && belongsTo(resource.data.accountId))
          || (
            belongsTo(resource.data.accountId)
            && isAssignedProfessional(resource.data.professionalId)
          )
        )
        && accountAccessActive(resource.data.accountId)
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'firstContactAt',
          'scheduledAt',
          'notes',
          'updatedAtMs'
        ]);
    }

    match /triageSessions/{sessionId} {
      allow read, write: if false;
    }

    match /usage/{usageId} {
      allow read: if isHq() || belongsTo(resource.data.accountId);
      allow write: if false;
    }

    match /usageReservations/{reservationId} {
      allow read, write: if false;
    }

    match /analysisCache/{cacheId} {
      allow read, write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isHq();
      allow write: if false;
    }

    match /subscriptionHistory/{historyId} {
      allow read: if isHq();
      allow write: if false;
    }

    match /paymentOrders/{orderId} {
      allow read, write: if false;
    }

    match /paymentTransactions/{transactionId} {
      allow read, write: if false;
    }

    match /assistantUsage/{usageId} {
      allow read, write: if false;
    }

    match /assistantAudit/{auditId} {
      allow read, write: if false;
    }

    match /assistantDefinitions/{assistantId} {
      allow read, write: if false;
    }

    match /assistantKnowledge/{knowledgeId} {
      allow read, write: if false;
    }

    match /accountAssistantSettings/{accountId} {
      allow read, write: if false;
    }

    match /customAssistantProfiles/{profileId} {
      allow read, write: if false;
    }

    match /assistantConversations/{conversationId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    match /assistantActions/{actionId} {
      allow read, write: if false;
    }

    match /assistantAuditLogs/{auditId} {
      allow read, write: if false;
    }

  }
}
