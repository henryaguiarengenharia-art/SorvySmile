rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isHq() {
      return signedIn() && currentUser().data.role == 'hq';
    }

    function belongsTo(accountId) {
      return signedIn() && currentUser().data.accountId == accountId;
    }

    match /publicProfiles/{slug} {
      allow get: if resource.data.active == true || isHq();
      allow list: if false;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isHq());
      allow write: if false;
    }

    match /accounts/{accountId} {
      allow read: if isHq() || belongsTo(accountId);
      allow write: if false;
    }

    match /professionals/{professionalId} {
      allow read: if isHq() || belongsTo(resource.data.accountId);
      allow create, delete: if false;
      allow update: if belongsTo(resource.data.accountId)
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'whatsapp',
          'city',
          'state',
          'bio',
          'bioLink',
          'standardMessage',
          'templates',
          'updatedAtMs'
        ]);
    }

    match /leads/{leadId} {
      allow read: if isHq() || belongsTo(resource.data.accountId);
      allow create, delete: if false;
      allow update: if (isHq() || belongsTo(resource.data.accountId))
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'firstContactAt',
          'scheduledAt',
          'notes',
          'updatedAtMs'
        ]);
    }

    match /triageSessions/{sessionId} {
      allow read, write: if false;
    }

    match /usage/{usageId} {
      allow read: if isHq() || belongsTo(resource.data.accountId);
      allow write: if false;
    }

    match /usageReservations/{reservationId} {
      allow read, write: if false;
    }

  }
}
