{
  "name": "sorvy-smile",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "FIREBASE_EMULATORS_PATH=/tmp/sorvysmile-firebase-emulators XDG_CACHE_HOME=/tmp/sorvysmile-xdg-cache XDG_CONFIG_HOME=/tmp/sorvysmile-xdg-config FIREBASE_CLI_DISABLE_UPDATE_CHECK=true firebase emulators:exec --project demo-sorvy-smile --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "build:all": "npm run build && npm --prefix functions run build",
    "test:all": "npm test && npm --prefix functions test",
    "setup:hml": "./scripts/setup-firebase-homologation.sh",
    "deploy:hml": "./scripts/deploy-firebase-homologation-full.sh",
    "repair:gemini:hml": "./scripts/repair-gemini-homologation.sh",
    "seed:hml": "./scripts/seed-firebase-homologation.sh",
    "smoke:hml": "node scripts/smoke-test-homologation.mjs"
  },
  "dependencies": {
    "firebase": "12.16.0",
    "lucide-react": "^0.462.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "4.1.0",
    "firebase-tools": "14.27.0"
  },
  "overrides": {
    "protobufjs": "7.6.5"
  }
}
