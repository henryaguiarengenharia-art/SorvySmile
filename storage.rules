rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function currentUser() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)); }
    function assignment(assignmentId) { return firestore.get(/databases/(default)/documents/dailyPostAssignments/$(assignmentId)); }
    function professional(professionalId) { return firestore.get(/databases/(default)/documents/professionals/$(professionalId)); }
    function professionalExists(professionalId) { return firestore.exists(/databases/(default)/documents/professionals/$(professionalId)); }
    function isDirectSignupOwner(accountId, professionalId) {
      return accountId == 'acc_' + request.auth.uid
        && professionalId == 'pro_' + request.auth.uid;
    }

    match /daily-posts/templates/{templateId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && currentUser().data.role == 'hq'
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /daily-posts/professionals/{professionalId}/{assignmentId}/{fileName} {
      allow read: if signedIn() && (
        currentUser().data.role == 'hq'
        || currentUser().data.professionalId == professionalId
        || (currentUser().data.role == 'clinic' && currentUser().data.accountId == assignment(assignmentId).data.accountId)
      );
      allow write: if signedIn()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && (
          currentUser().data.professionalId == professionalId
          || currentUser().data.role == 'hq'
          || (currentUser().data.role == 'clinic' && currentUser().data.accountId == assignment(assignmentId).data.accountId)
        );
    }

    match /assistant-assets/{accountId}/{professionalId}/{fileName} {
      allow get: if true;
      allow list: if false;
      allow write: if signedIn()
        && currentUser().data.role == 'hq'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|webp)');
    }

    match /professional-assets/{accountId}/{professionalId}/{fileName} {
      allow get: if true;
      allow list: if false;
      allow write: if signedIn()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && (
          isDirectSignupOwner(accountId, professionalId)
          || (
            professionalExists(professionalId)
            && professional(professionalId).data.accountId == accountId
            && (
              currentUser().data.role == 'hq'
              || currentUser().data.professionalId == professionalId
              || professional(professionalId).data.ownerUid == request.auth.uid
              || (currentUser().data.role == 'clinic' && currentUser().data.accountId == accountId)
            )
          )
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
